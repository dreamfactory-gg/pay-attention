{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pay Attention",
  "version": "0.1.0",
  "identifier": "gg.dreamfactory.pay-attention",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Pay Attention",
      "width": 360,
      "height": 520,
      "resizable": false,
      "decorations": false,
      "visible": false,
      "skipTaskbar": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": [] }
}
